{
  "grade": 3,
  "subject": "算数",
  "keywords": "わり算,あまり,万,小数,分数,円,半径,直径,二等辺三角形,正三角形,棒グラフ,g,kg",
  "bad_examples": [
    "6×3は？（単純九九）",
    "10+20は？（2年レベル）"
  ],
  "units": [
    {
      "name": "わり算",
      "key_concepts": [
        "わり算=等分・包含除",
        "あまりは割る数より小さい"
      ],
      "typical_mistakes": [
        "あまりと商を取り違える"
      ],
      "sample_questions": [
        {
          "q": "23÷5の商とあまりは？",
          "c": [
            "商4あまり3",
            "商3あまり4",
            "商5あまり2",
            "商4あまり5"
          ],
          "a": 0,
          "e": "5×4=20,23-20=3"
        }
      ]
    },
    {
      "name": "円と球",
      "key_concepts": [
        "半径=中心から円周まで",
        "直径=半径×2",
        "コンパスの使い方"
      ],
      "typical_mistakes": [
        "半径と直径を混同する"
      ],
      "sample_questions": [
        {
          "q": "半径4cmの円の直径は？",
          "c": [
            "4cm",
            "8cm",
            "2cm",
            "16cm"
          ],
          "a": 1,
          "e": "直径=半径×2"
        }
      ]
    },
    {
      "name": "小数",
      "key_concepts": [
        "0.1の位",
        "小数の大小比較"
      ],
      "typical_mistakes": [
        "0.3+0.5=0.35と答える"
      ],
      "sample_questions": [
        {
          "q": "0.3+0.5は？",
          "c": [
            "0.35",
            "0.8",
            "0.2",
            "8"
          ],
          "a": 1,
          "e": "0.3+0.5=0.8"
        }
      ]
    },
    {
      "name": "分数の導入",
      "key_concepts": [
        "分母と分子",
        "同分母の加減"
      ],
      "typical_mistakes": [
        "分母も足してしまう"
      ],
      "sample_questions": [
        {
          "q": "1/4+2/4は？",
          "c": [
            "3/8",
            "3/4",
            "2/4",
            "1/2"
          ],
          "a": 1,
          "e": "分子だけ足す"
        }
      ]
    },
    {
      "name": "三角形の分類",
      "key_concepts": [
        "二等辺三角形=2辺が等しい",
        "正三角形=3辺が等しい"
      ],
      "typical_mistakes": [
        "二等辺と正三角形を混同"
      ],
      "sample_questions": [
        {
          "q": "3つの辺の長さが全て同じ三角形は？",
          "c": [
            "二等辺三角形",
            "正三角形",
            "直角三角形",
            "鈍角三角形"
          ],
          "a": 1,
          "e": "3辺等しい=正三角形"
        }
      ]
    },
    {
      "name": "重さ(g,kg)",
      "key_concepts": [
        "1kg=1000g",
        "はかりの読み方"
      ],
      "typical_mistakes": [
        "kg→gの変換ミス"
      ],
      "sample_questions": [
        {
          "q": "2kg＝□g",
          "c": [
            "200",
            "2000",
            "20",
            "20000"
          ],
          "a": 1,
          "e": "1kg=1000g"
        }
      ]
    }
  ]
}