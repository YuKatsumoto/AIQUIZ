{
  "grade": 5,
  "subject": "算数",
  "keywords": "公倍数,公約数,約分,通分,異分母分数,割合,百分率,円グラフ,帯グラフ,体積,L,角柱,円柱,合同,多角形の角度,速さ",
  "bad_examples": [
    "4×8は？（九九）",
    "1/2+1/2は？（同分母）"
  ],
  "units": [
    {
      "name": "公倍数と公約数",
      "key_concepts": [
        "最小公倍数の求め方",
        "最大公約数の求め方"
      ],
      "typical_mistakes": [
        "公倍数と公約数を混同する"
      ],
      "sample_questions": [
        {
          "q": "4と6の最小公倍数は？",
          "c": [
            "12",
            "24",
            "2",
            "6"
          ],
          "a": 0,
          "e": "4×3=12,6×2=12"
        }
      ]
    },
    {
      "name": "異分母分数の加減",
      "key_concepts": [
        "通分して分母をそろえる",
        "約分で最も簡単な分数にする"
      ],
      "typical_mistakes": [
        "通分せず分母も足す(1/3+1/4=2/7)"
      ],
      "sample_questions": [
        {
          "q": "1/3+1/4は？",
          "c": [
            "2/7",
            "7/12",
            "4/12",
            "1/7"
          ],
          "a": 1,
          "e": "4/12+3/12=7/12"
        }
      ]
    },
    {
      "name": "割合と百分率",
      "key_concepts": [
        "割合=比べる量÷もとにする量",
        "百分率=割合×100",
        "歩合: 1割=0.1"
      ],
      "typical_mistakes": [
        "もとにする量と比べる量を取り違える"
      ],
      "sample_questions": [
        {
          "q": "200人中40人は何%？",
          "c": [
            "5%",
            "10%",
            "20%",
            "40%"
          ],
          "a": 2,
          "e": "40÷200=0.2=20%"
        }
      ]
    },
    {
      "name": "体積(cm³,m³,L)",
      "key_concepts": [
        "直方体の体積=たて×横×高さ",
        "1L=1000cm³"
      ],
      "typical_mistakes": [
        "面積と体積の公式を混同する"
      ],
      "sample_questions": [
        {
          "q": "たて3cm横4cm高さ5cmの直方体の体積は？",
          "c": [
            "12cm³",
            "60cm³",
            "47cm³",
            "24cm³"
          ],
          "a": 1,
          "e": "3×4×5=60"
        }
      ]
    },
    {
      "name": "合同な図形",
      "key_concepts": [
        "合同=形も大きさも同じ",
        "対応する辺・角"
      ],
      "typical_mistakes": [
        "裏返した図形を合同と判断できない"
      ],
      "sample_questions": [
        {
          "q": "合同な三角形の条件でないものは？",
          "c": [
            "3辺が等しい",
            "2辺とその間の角が等しい",
            "色が同じ",
            "1辺と両端の角が等しい"
          ],
          "a": 2,
          "e": "色は合同の条件ではない"
        }
      ]
    },
    {
      "name": "多角形の角度",
      "key_concepts": [
        "三角形の内角の和=180°",
        "四角形の内角の和=360°",
        "n角形=(n-2)×180°"
      ],
      "typical_mistakes": [
        "五角形の内角の和を360°とする"
      ],
      "sample_questions": [
        {
          "q": "五角形の内角の和は？",
          "c": [
            "360°",
            "540°",
            "720°",
            "480°"
          ],
          "a": 1,
          "e": "(5-2)×180=540"
        }
      ]
    }
  ]
}