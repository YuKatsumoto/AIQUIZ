{
  "grade": 5,
  "subject": "国語",
  "keywords": "4年漢字202字,敬語,和語漢語外来語,複合語,古典入門,意見文",
  "bad_examples": [
    "係り結びの法則（古文・中学）"
  ],
  "units": [
    {
      "name": "敬語の基本",
      "key_concepts": [
        "尊敬語=相手を高める",
        "謙譲語=自分を低める",
        "丁寧語=ですます"
      ],
      "typical_mistakes": [
        "尊敬語と謙譲語を逆にする"
      ],
      "sample_questions": [
        {
          "q": "「先生がおっしゃる」の敬語の種類は？",
          "c": [
            "丁寧語",
            "尊敬語",
            "謙譲語",
            "普通語"
          ],
          "a": 1,
          "e": "おっしゃる=尊敬語"
        }
      ]
    },
    {
      "name": "和語・漢語・外来語",
      "key_concepts": [
        "和語=やまとことば",
        "漢語=中国由来",
        "外来語=西洋由来"
      ],
      "typical_mistakes": [
        "漢語と和語を混同する"
      ],
      "sample_questions": [
        {
          "q": "「テーブル」は何語？",
          "c": [
            "和語",
            "漢語",
            "外来語",
            "方言"
          ],
          "a": 2,
          "e": "英語table由来=外来語"
        }
      ]
    },
    {
      "name": "古典に親しむ",
      "key_concepts": [
        "竹取物語",
        "枕草子",
        "古語の意味"
      ],
      "typical_mistakes": [
        "古語を現代語の意味で解釈する"
      ],
      "sample_questions": [
        {
          "q": "日本最古の物語は？",
          "c": [
            "源氏物語",
            "竹取物語",
            "枕草子",
            "平家物語"
          ],
          "a": 1,
          "e": "竹取物語=最古の物語"
        }
      ]
    },
    {
      "name": "複合語",
      "key_concepts": [
        "複合語=2つの言葉が結びつく",
        "音が変わる(雨+傘=あまがさ)"
      ],
      "typical_mistakes": [
        "複合語の音の変化に気づかない"
      ],
      "sample_questions": [
        {
          "q": "「雨」と「傘」が合わさるとどう読む？",
          "c": [
            "あめがさ",
            "あまがさ",
            "あめかさ",
            "あまかさ"
          ],
          "a": 1,
          "e": "雨=あま、濁って「あまがさ」"
        }
      ]
    },
    {
      "name": "同音異義語・同訓異字",
      "key_concepts": [
        "同音異義語(会う・合う)",
        "意味で漢字を使い分ける"
      ],
      "typical_mistakes": [
        "文脈に合わない漢字を選ぶ"
      ],
      "sample_questions": [
        {
          "q": "「友だちにアう」の正しい漢字は？",
          "c": [
            "会う",
            "合う",
            "遭う",
            "逢う"
          ],
          "a": 0,
          "e": "人と会う=会う"
        }
      ]
    },
    {
      "name": "意見文と要旨",
      "key_concepts": [
        "事実と意見を分ける",
        "理由と主張の組み立て"
      ],
      "typical_mistakes": [
        "事実と意見を区別できない"
      ],
      "sample_questions": [
        {
          "q": "意見文で主張を支えるのは？",
          "c": [
            "理由や根拠",
            "感想だけ",
            "題名",
            "字数"
          ],
          "a": 0,
          "e": "主張=理由・根拠で支える"
        }
      ]
    }
  ]
}