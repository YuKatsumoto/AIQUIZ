      "sample_questions": [
        {
          "q": "「山」の読み方は？",
          "c": [
            "やま・サン",
            "うみ・カイ",
            "かわ・セン",
            "もり・シン"
          ],
          "a": 0,
          "e": "山=やま(訓)・サン(音)"
        }
      ]
    },
    {
      "name": "主語と述語",
      "key_concepts": [
        "主語=だれが・なにが",
        "述語=どうする・どんなだ"
      ],
      "typical_mistakes": [
        "主語と述語を逆に答える"
      ],
      "sample_questions": [
        {
          "q": "「花が咲く」の主語は？",
          "c": [
            "花が",
            "咲く",
            "花",
            "が"
          ],
          "a": 0,
          "e": "「何が」=主語"
        }
      ]
    },
    {
      "name": "物語の読み取り",
      "key_concepts": [
        "場面の変化",
        "登場人物の気持ち"
      ],
      "typical_mistakes": [
        "自分の気持ちと登場人物の気持ちを混同"
      ],
      "sample_questions": [
        {
          "q": "物語で「いつ・どこで・だれが」を確認するのは？",
          "c": [
            "場面の設定",
            "あらすじ",
            "感想",
            "テーマ"
          ],
          "a": 0,
          "e": "5W1H=場面の設定"
        }
      ]
    }
  ]
