{
  "grade": 4,
  "subject": "国語",
  "keywords": "3年漢字200字,慣用句,ことわざ,故事成語,つなぎ言葉,要約",
  "bad_examples": [
    "敬語の5分類（中学レベル）"
  ],
  "units": [
    {
      "name": "慣用句・ことわざ",
      "key_concepts": [
        "慣用句=体の部分を使った言い回し",
        "ことわざ=昔からの教え"
      ],
      "typical_mistakes": [
        "慣用句の意味を文字通りに取る"
      ],
      "sample_questions": [
        {
          "q": "「猫の手も借りたい」の意味は？",
          "c": [
            "猫が好き",
            "とても忙しい",
            "猫を飼いたい",
            "手が痛い"
          ],
          "a": 1,
          "e": "とても忙しいという慣用句"
        }
      ]
    },
    {
      "name": "つなぎ言葉(接続語)",
      "key_concepts": [
        "しかし=逆接",
        "だから=順接",
        "また=並列"
      ],
      "typical_mistakes": [
        "「しかし」と「だから」を混同"
      ],
      "sample_questions": [
        {
          "q": "「雨が降った。＿＿遠足は中止だ」に入る言葉は？",
          "c": [
            "しかし",
            "だから",
            "また",
            "ところで"
          ],
          "a": 1,
          "e": "原因→結果=だから"
        }
      ]
    },
    {
      "name": "要約と要旨",
      "key_concepts": [
        "大事な文を見つける",
        "段落ごとのまとめ"
      ],
      "typical_mistakes": [
        "細かい例を要約に入れてしまう"
      ],
      "sample_questions": [
        {
          "q": "要約で最も大切なことは？",
          "c": [
            "全部書く",
            "大事なことだけまとめる",
            "感想を入れる",
            "長く書く"
          ],
          "a": 1,
          "e": "要約=大事な部分の要約"
        }
      ]
    },
    {
      "name": "漢字の音と訓・熟語",
      "key_concepts": [
        "音読み=中国の読み",
        "訓読み=日本の読み",
        "熟語の読み方"
      ],
      "typical_mistakes": [
        "音読みと訓読みを混同する"
      ],
      "sample_questions": [
        {
          "q": "「校門」の読み方の種類は？",
          "c": [
            "音＋音",
            "訓＋訓",
            "音＋訓",
            "訓＋音"
          ],
          "a": 0,
          "e": "コウ＋モン=音＋音"
        }
      ]
    },
    {
      "name": "へんとつくり(漢字の組み立て)",
      "key_concepts": [
        "へん=左側",
        "つくり=右側",
        "部首の意味"
      ],
      "typical_mistakes": [
        "へんとつくりを左右逆に考える"
      ],
      "sample_questions": [
        {
          "q": "「words」を表す「言」のような左側の部分は？",
          "c": [
            "へん",
            "つくり",
            "かんむり",
            "あし"
          ],
          "a": 0,
          "e": "左側の部首=へん"
        }
      ]
    },
    {
      "name": "故事成語",
      "key_concepts": [
        "矛盾=つじつまが合わない",
        "漁夫の利=第三者が得をする"
      ],
      "typical_mistakes": [
        "故事成語の由来と意味を取り違える"
      ],
      "sample_questions": [
        {
          "q": "「矛盾」の意味は？",
          "c": [
            "つじつまが合わない",
            "とても強い",
            "助け合う",
            "急いで進む"
          ],
          "a": 0,
          "e": "話の筋が合わない=矛盾"
        }
      ]
    }
  ]
}