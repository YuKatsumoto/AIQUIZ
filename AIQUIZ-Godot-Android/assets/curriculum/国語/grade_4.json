{
  "grade": 4,
  "subject": "国語",
  "keywords": "3年漢字200字,慣用句,ことわざ,故事成語,つなぎ言葉,要約",
  "bad_examples": [
    "敬語の5分類（中学レベル）"
  ],
  "units": [
    {
      "name": "慣用句・ことわざ",
      "key_concepts": [
        "慣用句=体の部分を使った言い回し",
        "ことわざ=昔からの教え"
      ],
      "typical_mistakes": [
        "慣用句の意味を文字通りに取る"
      ],
      "sample_questions": [
        {
          "q": "「猫の手も借りたい」の意味は？",
          "c": [
            "猫が好き",
            "とても忙しい",
            "猫を飼いたい",
            "手が痛い"
          ],
          "a": 1,
          "e": "とても忙しいという慣用句"
        }
      ]
    },
    {
      "name": "つなぎ言葉(接続語)",
      "key_concepts": [
        "しかし=逆接",
        "だから=順接",
        "また=並列"
      ],
      "typical_mistakes": [
        "「しかし」と「だから」を混同"
      ],
      "sample_questions": [
        {
          "q": "「雨が降った。＿＿遠足は中止だ」に入る言葉は？",
          "c": [
            "しかし",
            "だから",
            "また",
            "ところで"
          ],
          "a": 1,
          "e": "原因→結果=だから"
        }
      ]
    },
    {
      "name": "要約と要旨",
      "key_concepts": [
        "大事な文を見つける",
        "段落ごとのまとめ"
      ],
      "typical_mistakes": [
        "細かい例を要約に入れてしまう"
      ],
      "sample_questions": [
        {
          "q": "要約で最も大切なことは？",
          "c": [
            "全部書く",
            "大事なことだけまとめる",
            "感想を入れる",
            "長く書く"
          ],
          "a": 1,
          "e": "要約=大事な部分の要約"
        }
      ]
    }
  ]
}