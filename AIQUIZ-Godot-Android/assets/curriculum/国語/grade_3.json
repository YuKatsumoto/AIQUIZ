  "units": [
    {
      "name": "2年生の漢字(160字)",
      "key_concepts": [
        "同音異義語",
        "部首の意味"
      ],
      "typical_mistakes": [
        "「買う」と「飼う」を混同"
      ],
      "sample_questions": [
        {
          "q": "「読書」の「読」の部首は？",
          "c": [
            "言(ごんべん)",
            "売",
            "目",
            "木"
          ],
          "a": 0,
          "e": "言葉に関連=ごんべん"
        }
      ]
    },
    {
      "name": "ローマ字",
      "key_concepts": [
        "母音=a,i,u,e,o",
        "ヘボン式と訓令式"
      ],
      "typical_mistakes": [
        "「し」をsiと書く(ヘボン式はshi)"
      ],
      "sample_questions": [
        {
          "q": "「つ」のローマ字(訓令式)は？",
          "c": [
            "tu",
            "tsu",
            "su",
            "cu"
          ],
          "a": 0,
          "e": "訓令式: tu"
        }
      ]
    },
    {
      "name": "修飾語",
      "key_concepts": [
        "修飾語=詳しくする言葉",
        "被修飾語=詳しくされる言葉"
      ],
      "typical_mistakes": [
        "修飾語と被修飾語を逆にする"
      ],
      "sample_questions": [
        {
          "q": "「大きい犬」で「大きい」は何？",
          "c": [
            "主語",
            "述語",
            "修飾語",
            "接続語"
          ],
          "a": 2,
          "e": "犬を詳しくしている=修飾語"
        }
      ]
    },
    {
      "name": "国語辞典の使い方",
      "key_concepts": [
        "五十音順に並ぶ",
        "見出し語と言葉の意味"
      ],
      "typical_mistakes": [
        "濁点・半濁点の並び順を間違える"
      ],
      "sample_questions": [
        {
          "q": "国語辞典で先に出るのは？",
          "c": [
            "あさ",
            "あめ",
            "いえ",
            "うみ"
          ],
          "a": 0,
          "e": "五十音順で「あさ」が先"
        }
      ]
    },
    {
      "name": "こそあど言葉(指示語)",
      "key_concepts": [
        "これ・それ・あれ・どれ",
        "指す内容を前から探す"
      ],
      "typical_mistakes": [
        "指示語が指す言葉を取り違える"
      ],
      "sample_questions": [
        {
          "q": "近くの物を指す言葉は？",
          "c": [
            "これ",
            "それ",
            "あれ",
            "どれ"
          ],
          "a": 0,
          "e": "自分に近い=これ"
        }
      ]
    },
    {
      "name": "段落のまとまり",
      "key_concepts": [
        "段落=内容のまとまり",
        "中心となる文"
      ],
      "typical_mistakes": [
        "段落の中心文を見つけられない"
      ],
      "sample_questions": [
        {
          "q": "文章を内容ごとに区切ったまとまりは？",
          "c": [
            "段落",
            "句点",
            "見出し",
            "題名"
          ],
          "a": 0,
          "e": "内容のまとまり=段落"
        }
      ]
    }
  ]
}