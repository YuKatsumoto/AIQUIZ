{
  "grade": 6,
  "subject": "国語",
  "keywords": "5年漢字193字,文の構造,熟語の成り立ち,随筆,推敲,短歌俳句",
  "bad_examples": [
    "漢文の返り点（中学）"
  ],
  "units": [
    {
      "name": "熟語の成り立ち",
      "key_concepts": [
        "似た意味の漢字(温暖)",
        "反対の意味(高低)",
        "修飾関係(急行)"
      ],
      "typical_mistakes": [
        "熟語の構成パターンを見分けられない"
      ],
      "sample_questions": [
        {
          "q": "「高低」はどんな組み合わせ？",
          "c": [
            "似た意味",
            "反対の意味",
            "修飾関係",
            "主述関係"
          ],
          "a": 1,
          "e": "高い⇔低い=反対"
        }
      ]
    },
    {
      "name": "短歌と俳句",
      "key_concepts": [
        "短歌=5・7・5・7・7",
        "俳句=5・7・5+季語"
      ],
      "typical_mistakes": [
        "短歌と俳句の音数を混同する"
      ],
      "sample_questions": [
        {
          "q": "俳句の音数は？",
          "c": [
            "5・7・5",
            "5・7・5・7・7",
            "7・7",
            "自由"
          ],
          "a": 0,
          "e": "俳句=5・7・5"
        }
      ]
    },
    {
      "name": "文の構造",
      "key_concepts": [
        "単文・複文・重文",
        "修飾・被修飾の関係"
      ],
      "typical_mistakes": [
        "複文と重文の区別"
      ],
      "sample_questions": [
        {
          "q": "「風が吹いて、桶屋が儲かる」は何文？",
          "c": [
            "単文",
            "複文",
            "重文",
            "疑問文"
          ],
          "a": 2,
          "e": "対等な文=重文"
        }
      ]
    },
    {
      "name": "敬語の正しい使い方",
      "key_concepts": [
        "尊敬語・謙譲語・丁寧語",
        "相手と自分で使い分ける"
      ],
      "typical_mistakes": [
        "二重敬語を使ってしまう"
      ],
      "sample_questions": [
        {
          "q": "「先生が来る」の尊敬語は？",
          "c": [
            "いらっしゃる",
            "まいる",
            "参上する",
            "うかがう"
          ],
          "a": 0,
          "e": "来るの尊敬語=いらっしゃる"
        }
      ]
    },
    {
      "name": "慣用句・故事成語の活用",
      "key_concepts": [
        "慣用句で気持ちを表す",
        "故事成語の意味と使い方"
      ],
      "typical_mistakes": [
        "慣用句を文字通りの意味で使う"
      ],
      "sample_questions": [
        {
          "q": "「気が置けない」の意味は？",
          "c": [
            "遠慮がいらない",
            "油断できない",
            "気に入らない",
            "緊張する"
          ],
          "a": 0,
          "e": "気をつかわない=気が置けない"
        }
      ]
    },
    {
      "name": "文章の推敲",
      "key_concepts": [
        "主語と述語の対応",
        "重複やねじれを直す"
      ],
      "typical_mistakes": [
        "主語と述語がねじれた文に気づかない"
      ],
      "sample_questions": [
        {
          "q": "推敲で最も大切なことは？",
          "c": [
            "意味が正しく伝わるか確かめる",
            "字を大きく書く",
            "長く書く",
            "難しい漢字を使う"
          ],
          "a": 0,
          "e": "推敲=伝わるか見直す"
        }
      ]
    }
  ]
}