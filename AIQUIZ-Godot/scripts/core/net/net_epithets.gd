## サイコロ 1 回分。rng を渡すとテストで再現できる。
static func roll(rng: RandomNumberGenerator = null) -> String:
	if rng == null:
		rng = RandomNumberGenerator.new()
		rng.randomize()
	for _attempt in range(64):
		var candidate := ""
		if rng.randf() < RARE_CHANCE:
			candidate = RARE[rng.randi_range(0, RARE.size() - 1)]
		else:
			candidate = TITLES[rng.randi_range(0, TITLES.size() - 1)] + NAMES[rng.randi_range(0, NAMES.size() - 1)]
		if NetNameFilter.is_ok(candidate):
			return candidate
	return "謎のパンダ"


static func combination_count() -> int:
	return TITLES.size() * NAMES.size() + RARE.size()
