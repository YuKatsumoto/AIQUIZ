        {"do": "arc_arrow", "at": [ 2.85, 0.32 ], "r": 0.25, "color": "yellow"},
        {"do": "write", "text": "速いほど", "at": [ 0.4, 0.1 ], "h": 0.2, "drift": 0.03, "color": "white"},
        {"do": "admire", "at": [ 0.8, 0.15 ], "unhappy": true},
        {"do": "erase", "rect": [ 0.3, 0.0, 1.35, 0.31 ]},
        {"do": "write", "text": "速いほど", "at": [ 0.4, 0.08 ], "h": 0.2, "color": "white"},
        {"do": "write", "text": "はなれる", "at": [ 1.3, 0.08 ], "h": 0.2, "color": "red"},
        {"do": "wavy", "from": [ 1.32, 0.05 ], "to": [ 2.15, 0.05 ], "color": "red"},
