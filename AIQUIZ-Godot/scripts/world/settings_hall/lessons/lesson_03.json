{
  "title": "第3講　安全な観察距離と回転数",
  "note": "lecture_director.gd が上から順に流す。座標は黒板の面の上のメートル（u = 見る人の左端から右へ、v = 下端から上へ、下の黒板 F）。先生の手が届くのは v 0.05〜0.6 まで。左（u 0.3〜3.45）が板書、中ほど（u 3.9〜5.5）が図、右端（u 6.4〜）が日付と日直。文字はここに出てくる字だけ tools/settings_hall/glyph_strokes.py が線にする。{date} は PC の今日の日付。 prelude_<時間帯> は時間帯の場面（lecture_director.gd の day_mode）。",
  "prelude": [
    {"do": "doodle", "at": [ 2.2, 0.3 ]},
    {"do": "freeze"},
    {"do": "to_seats"},
    {"do": "erase", "rect": [ 1.85, 0.02, 2.6, 0.6 ], "messy": true},
    {"do": "walk", "to": "lectern", "face": 180},
    {"do": "event", "name": "rei"},
    {"do": "chime"}
  ],
  "prelude_lunch": [
    {"do": "lunch", "secs": 45},
    {"do": "walk", "to": "lectern", "face": 180},
    {"do": "event", "name": "rei"},
    {"do": "chime"}
  ],
  "prelude_after_school": [
    {"do": "cleaning"},
    {"do": "walk", "to": "lectern", "face": 180},
    {"do": "event", "name": "rei"},
    {"do": "chime"}
  ],
  "prelude_night": [
    {"do": "night", "secs": 40},
    {"do": "walk", "to": "lectern", "face": 180},
    {"do": "event", "name": "rei"},
    {"do": "chime"}
