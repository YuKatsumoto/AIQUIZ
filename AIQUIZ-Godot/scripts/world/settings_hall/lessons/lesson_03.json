        {"do": "gag", "pool": [ "doze_throw", "whistle" ]},
        {"do": "slide", "dir": "up"},
        {"do": "write", "board": "B", "text": "次回 第4講 停止の合図", "at": [ 0.4, 0.1 ], "h": 0.16, "color": "white", "once": true},
        {"do": "slide", "dir": "down"},
        {"do": "bow", "cue": "bow"},
        {"do": "event", "name": "duty_erase", "rects": [ [ 0.3, 0.0, 3.6, 0.62 ], [ 3.85, 0.0, 5.45, 0.62 ] ]},
        {"do": "event", "name": "janitor"}
      ]
