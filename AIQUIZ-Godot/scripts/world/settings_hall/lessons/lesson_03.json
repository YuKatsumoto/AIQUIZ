        {"do": "write", "text": "早すぎると刃に当たる", "at": [ 0.4, 0.08 ], "h": 0.13, "grow": 0.12, "limit": 3.4, "color": "red", "cue": "notes"},
        {"do": "admire", "at": [ 1.6, 0.25 ], "unhappy": true},
        {"do": "point", "at": [ 1.6, 0.18 ], "cue": "frenzy"},
        {"do": "gag", "pool": [ "sneeze", "snap_chalk", "look_up" ]},
        {"do": "write_high", "how": "ride", "text": "跳べ！", "at": [ 1.1, 1.12 ], "h": 0.18, "color": "yellow"},
