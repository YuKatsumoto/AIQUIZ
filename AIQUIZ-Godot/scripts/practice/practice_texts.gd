const QualityRules = preload("res://scripts/core/graphics_quality.gd")


static func has_text(id: String) -> bool:
	return TEXTS.has(id)


## ID の文字。ない ID は「[ID]」を返して警告を出す（台本と実装のずれに気づけるように）。
## スマホでは、キーを言う行を TOUCH_TEXTS の言い方に替える。
static func get_text(id: String) -> String:
	if TOUCH_TEXTS.has(id) and QualityRules.is_mobile_target():
		return TOUCH_TEXTS[id]
	if TEXTS.has(id):
		return TEXTS[id]
	push_warning("PracticeTexts: no text for \"%s\"" % id)
	return "[%s]" % id


## 「／」で区切った部品（壁の2行、ボタンの並び、カウントダウン）。区切りがなければ1つだけ。
static func get_parts(id: String) -> PackedStringArray:
	return get_text(id).split("／")
