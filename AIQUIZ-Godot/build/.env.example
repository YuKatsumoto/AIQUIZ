# ============================================
# AIQUIZ 3D - 設定ファイル (.env)
# ============================================
# このファイルに API キーを設定すると、オンラインモード（AI問題生成）が使えます。
# オフラインモードは設定不要でプレイできます。

# --- LLM API キー（オンラインモード用） ---
# OpenAI を使う場合:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# Google Gemini を使う場合:
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- LLM 設定 ---
LLM_BATCH_QUESTION_COUNT=5
LLM_BATCH_QUESTION_COUNT_TEN=5
LLM_SPLIT_WAIT_SECONDS=4.0
LLM_SPLIT_WAIT_SECONDS_TEN=0.5

# --- Firebase（評価データの共有） ---
FIREBASE_DB_URL=https://aiquiz-a12f6-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_RATINGS_PATH=quiz_ratings/shared

# --- グラフィックス設定 ---
TARGET_FPS=120
VSYNC=1
MSAA_SAMPLES=4
