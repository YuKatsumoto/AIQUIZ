; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AIQUIZ 3D"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.jpg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
QuizManager="*res://scripts/autoload/quiz_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
ApiStatusAutoload="*res://scripts/core/api_status.gd"
SceneTransition="*res://scripts/autoload/scene_transition.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

