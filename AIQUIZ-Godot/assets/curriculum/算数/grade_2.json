{
  "grade": 2,
  "subject": "算数",
  "keywords": "九九,筆算,cm,mm,m,L,dL,直角,三角形,四角形,時刻,時間",
  "bad_examples": [
    "2+3は？（1年レベル）",
    "5×1は？（簡単すぎ）"
  ],
  "units": [
    {
      "name": "かけ算（九九）",
      "key_concepts": [
        "九九の暗唱",
        "かけ算の意味=同じ数ずつ"
      ],
      "typical_mistakes": [
        "7の段・8の段の暗記間違い"
      ],
      "sample_questions": [
        {
          "q": "7×8はいくつ？",
          "c": [
            "54",
            "56",
            "48",
            "63"
          ],
          "a": 1,
          "e": "7×8=56"
        }
      ]
    },
    {
      "name": "長さの単位",
      "key_concepts": [
        "1m=100cm",
        "1cm=10mm"
      ],
      "typical_mistakes": [
        "1m=10cmと答える"
      ],
      "sample_questions": [
        {
          "q": "1m＝□cm",
          "c": [
            "10",
            "100",
            "1000",
            "50"
          ],
          "a": 1,
          "e": "1m=100cm"
        }
      ]
    },
    {
      "name": "時刻と時間",
      "key_concepts": [
        "時刻=いつ",
        "時間=どれだけ",
        "1時間=60分"
      ],
      "typical_mistakes": [
        "30分後を30時と答える"
      ],
      "sample_questions": [
        {
          "q": "2時40分から30分後は？",
          "c": [
            "2時70分",
            "3時10分",
            "3時00分",
            "2時50分"
          ],
          "a": 1,
          "e": "40+30=70→3時10分"
        }
      ]
    },
    {
      "name": "1000までの数",
      "key_concepts": [
        "百の位・十の位・一の位",
        "数直線"
      ],
      "typical_mistakes": [
        "百の位の繰り上がり"
      ],
      "sample_questions": [
        {
          "q": "30+50+20は？",
          "c": [
            "90",
            "100",
            "110",
            "80"
          ],
          "a": 1,
          "e": "30+50+20=100"
        }
      ]
    },
    {
      "name": "三角形と四角形",
      "key_concepts": [
        "直角",
        "辺と頂点"
      ],
      "typical_mistakes": [
        "直角の概念"
      ],
      "sample_questions": [
        {
          "q": "直角は何度？",
          "c": [
            "45°",
            "60°",
            "90°",
            "180°"
          ],
          "a": 2,
          "e": "直角=90°"
        }
      ]
    }
  ]
}