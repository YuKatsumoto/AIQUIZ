{
  "grade": 1,
  "subject": "算数",
  "keywords": "繰り上がり,繰り下がり,10のまとまり,時計,長い・短い",
  "bad_examples": [
    "3+2は？（簡単すぎ）",
    "1+1は？"
  ],
  "units": [
    {
      "name": "繰り上がりのたし算",
      "key_concepts": [
        "10のまとまりを作る",
        "9+6→10+5=15"
      ],
      "typical_mistakes": [
        "10の位への加算を忘れる"
      ],
      "sample_questions": [
        {
          "q": "9+6はいくつ？",
          "c": [
            "6",
            "15",
            "14",
            "16"
          ],
          "a": 1,
          "e": "10+5=15"
        }
      ]
    },
    {
      "name": "繰り下がりのひき算",
      "key_concepts": [
        "10から引いて足す",
        "15-8→10-8+5=7"
      ],
      "typical_mistakes": [
        "引く数と引かれる数を逆にする"
      ],
      "sample_questions": [
        {
          "q": "15-8はいくつ？",
          "c": [
            "5",
            "6",
            "7",
            "8"
          ],
          "a": 2,
          "e": "10-8+5=7"
        }
      ]
    },
    {
      "name": "時計の読み方",
      "key_concepts": [
        "長い針=分",
        "短い針=時"
      ],
      "typical_mistakes": [
        "長い針と短い針を取り違える"
      ],
      "sample_questions": [
        {
          "q": "3時30分のとき長い針はどの数字？",
          "c": [
            "3",
            "6",
            "9",
            "12"
          ],
          "a": 1,
          "e": "30分=6の位置"
        }
      ]
    },
    {
      "name": "20より大きい数",
      "key_concepts": [
        "十の位と一の位",
        "数の大小比較"
      ],
      "typical_mistakes": [
        "位取りの理解不足"
      ],
      "sample_questions": [
        {
          "q": "10が2つと1が5つでいくつ？",
          "c": [
            "25",
            "15",
            "52",
            "7"
          ],
          "a": 0,
          "e": "20+5=25"
        }
      ]
    },
    {
      "name": "かたちあそび",
      "key_concepts": [
        "三角・四角・丸の弁別",
        "立体と平面の違い"
      ],
      "typical_mistakes": [
        "三角形と四角形の区別"
      ],
      "sample_questions": [
        {
          "q": "角が3つある形は？",
          "c": [
            "三角形",
            "四角形",
            "丸",
            "星"
          ],
          "a": 0,
          "e": "角3つ=三角形"
        }
      ]
    }
  ]
}