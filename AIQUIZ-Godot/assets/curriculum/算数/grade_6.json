{
  "grade": 6,
  "subject": "算数",
  "keywords": "分数のかけ算わり算,比,比例,反比例,対称,拡大,縮小,縮図,柱体,錐体,資料の整理,平均,場合の数",
  "bad_examples": [
    "8÷2は？（低学年）",
    "100×5は？（単純計算）"
  ],
  "units": [
    {
      "name": "分数のかけ算わり算",
      "key_concepts": [
        "分数×分数=分子同士・分母同士",
        "分数÷分数=逆数をかける"
      ],
      "typical_mistakes": [
        "わり算で逆数にし忘れる"
      ],
      "sample_questions": [
        {
          "q": "2/3÷4/5は？",
          "c": [
            "8/15",
            "5/6",
            "10/12",
            "6/20"
          ],
          "a": 1,
          "e": "2/3×5/4=10/12=5/6"
        }
      ]
    },
    {
      "name": "比と比の値",
      "key_concepts": [
        "比=A:B",
        "比の値=A÷B",
        "等しい比"
      ],
      "typical_mistakes": [
        "比を分数に変換する際に逆にする"
      ],
      "sample_questions": [
        {
          "q": "3:5と等しい比は？",
          "c": [
            "6:10",
            "5:3",
            "9:20",
            "3:10"
          ],
          "a": 0,
          "e": "3×2:5×2=6:10"
        }
      ]
    },
    {
      "name": "比例と反比例",
      "key_concepts": [
        "比例: y=ax",
        "反比例: y=a/x",
        "グラフの特徴"
      ],
      "typical_mistakes": [
        "比例と反比例の式を取り違える"
      ],
      "sample_questions": [
        {
          "q": "xが2倍になるとyも2倍になる関係は？",
          "c": [
            "比例",
            "反比例",
            "等差",
            "無関係"
          ],
          "a": 0,
          "e": "比例の定義"
        }
      ]
    },
    {
      "name": "対称な図形",
      "key_concepts": [
        "線対称: 折り目で重なる",
        "点対称: 180°回転で重なる"
      ],
      "typical_mistakes": [
        "線対称と点対称を混同する"
      ],
      "sample_questions": [
        {
          "q": "正方形は線対称の軸が何本？",
          "c": [
            "2本",
            "4本",
            "1本",
            "8本"
          ],
          "a": 1,
          "e": "対角線2本+辺の中点2本=4本"
        }
      ]
    },
    {
      "name": "場合の数",
      "key_concepts": [
        "順列と組み合わせの違い",
        "樹形図"
      ],
      "typical_mistakes": [
        "順列と組み合わせを混同する"
      ],
      "sample_questions": [
        {
          "q": "A,B,C 3人の並び方は何通り？",
          "c": [
            "3通り",
            "6通り",
            "9通り",
            "12通り"
          ],
          "a": 1,
          "e": "3×2×1=6"
        }
      ]
    },
    {
      "name": "資料の整理",
      "key_concepts": [
        "平均=合計÷個数",
        "度数分布表",
        "柱状グラフ"
      ],
      "typical_mistakes": [
        "平均の計算で個数を間違える"
      ],
      "sample_questions": [
        {
          "q": "3,5,7の平均は？",
          "c": [
            "3",
            "5",
            "7",
            "15"
          ],
          "a": 1,
          "e": "(3+5+7)÷3=5"
        }
      ]
    }
  ]
}