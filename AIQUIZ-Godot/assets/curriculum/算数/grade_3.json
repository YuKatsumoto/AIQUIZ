{
  "grade": 3,
  "subject": "算数",
  "keywords": "わり算,あまり,万,たし算,ひき算,かけ算,小数,分数,円,半径,直径,二等辺三角形,正三角形,時刻,時間,秒,km,表,棒グラフ,g,kg",
  "bad_examples": [
    "6×3は？（単純九九）",
    "10+20は？（2年レベル）"
  ],
  "units": [
    {
      "name": "わり算",
      "key_concepts": [
        "わり算=等分・包含除",
        "あまりは割る数より小さい"
      ],
      "typical_mistakes": [
        "あまりと商を取り違える"
      ],
      "sample_questions": [
        {
          "q": "23÷5の商とあまりは？",
          "c": [
            "商4あまり3",
            "商3あまり4",
            "商5あまり2",
            "商4あまり5"
          ],
          "a": 0,
          "e": "5×4=20,23-20=3"
        }
      ]
    },
    {
      "name": "円と球",
      "key_concepts": [
        "半径=中心から円周まで",
        "直径=半径×2",
        "コンパスの使い方"
      ],
      "typical_mistakes": [
        "半径と直径を混同する"
      ],
      "sample_questions": [
        {
          "q": "半径4cmの円の直径は？",
          "c": [
            "4cm",
            "8cm",
            "2cm",
            "16cm"
          ],
          "a": 1,
          "e": "直径=半径×2"
        }
      ]
    },
    {
      "name": "小数",
      "key_concepts": [
        "0.1の位",
        "小数の大小比較"
      ],
      "typical_mistakes": [
        "0.3+0.5=0.35と答える"
      ],
      "sample_questions": [
        {
          "q": "0.3+0.5は？",
          "c": [
            "0.35",
            "0.8",
            "0.2",
            "8"
          ],
          "a": 1,
          "e": "0.3+0.5=0.8"
        }
      ]
    },
    {
      "name": "分数の導入",
      "key_concepts": [
        "分母と分子",
        "同分母の加減"
      ],
      "typical_mistakes": [
        "分母も足してしまう"
      ],
      "sample_questions": [
        {
          "q": "1/4+2/4は？",
          "c": [
            "3/8",
            "3/4",
            "2/4",
            "1/2"
          ],
          "a": 1,
          "e": "分子だけ足す"
        }
      ]
    },
    {
      "name": "三角形の分類",
      "key_concepts": [
        "二等辺三角形=2辺が等しい",
        "正三角形=3辺が等しい"
      ],
      "typical_mistakes": [
        "二等辺と正三角形を混同"
      ],
      "sample_questions": [
        {
          "q": "3つの辺の長さが全て同じ三角形は？",
          "c": [
            "二等辺三角形",
            "正三角形",
            "直角三角形",
            "鈍角三角形"
          ],
          "a": 1,
          "e": "3辺等しい=正三角形"
        }
      ]
    },
    {
      "name": "重さ(g,kg)",
      "key_concepts": [
        "1kg=1000g",
        "はかりの読み方"
      ],
      "typical_mistakes": [
        "kg→gの変換ミス"
      ],
      "sample_questions": [
        {
          "q": "2kg＝□g",
          "c": [
            "200",
            "2000",
            "20",
            "20000"
          ],
          "a": 1,
          "e": "1kg=1000g"
        }
      ]
    },
    {
      "name": "大きな数",
      "key_concepts": [
        "一万より大きい数の位取り",
        "数直線上の大きな数",
        "10倍・100倍・10分の1"
      ],
      "typical_mistakes": [
        "位を一つずらし間違える"
      ],
      "sample_questions": [
        {
          "q": "3万と400を合わせた数は？",
          "c": ["30400", "34000", "30040", "3040"],
          "a": 0,
          "e": "3万は30000なので30000+400=30400"
        }
      ]
    },
    {
      "name": "たし算とひき算の筆算",
      "key_concepts": [
        "3桁や4桁の加法・減法",
        "繰り上がりと繰り下がり",
        "加法と減法の関係"
      ],
      "typical_mistakes": [
        "位をそろえずに計算する"
      ],
      "sample_questions": [
        {
          "q": "425円から178円使うと残りは？",
          "c": ["247円", "253円", "357円", "603円"],
          "a": 0,
          "e": "425-178=247"
        }
      ]
    },
    {
      "name": "かけ算の筆算",
      "key_concepts": [
        "2桁や3桁に1桁をかける計算",
        "2桁どうしの乗法",
        "乗法の結合法則・分配法則"
      ],
      "typical_mistakes": [
        "繰り上がりを足し忘れる"
      ],
      "sample_questions": [
        {
          "q": "1箱24本の鉛筆が3箱あります。全部で何本？",
          "c": ["72本", "62本", "27本", "81本"],
          "a": 0,
          "e": "24×3=72"
        }
      ]
    },
    {
      "name": "時刻と時間",
      "key_concepts": [
        "時刻と経過時間の違い",
        "1分=60秒",
        "簡単な時間の加減"
      ],
      "typical_mistakes": [
        "時刻と時間を取り違える"
      ],
      "sample_questions": [
        {
          "q": "9時40分から30分後の時刻は？",
          "c": ["10時10分", "9時70分", "10時20分", "9時10分"],
          "a": 0,
          "e": "20分で10時、さらに10分で10時10分"
        }
      ]
    },
    {
      "name": "長さと距離",
      "key_concepts": [
        "1km=1000m",
        "目的に合う長さの単位",
        "長さのおよその見当"
      ],
      "typical_mistakes": [
        "kmとmの関係を100倍と考える"
      ],
      "sample_questions": [
        {
          "q": "2km300mをmだけで表すと？",
          "c": ["2300m", "2030m", "230m", "2003m"],
          "a": 0,
          "e": "2km=2000mなので2000+300=2300m"
        }
      ]
    },
    {
      "name": "表と棒グラフ",
      "key_concepts": [
        "資料を分類して表に整理する",
        "棒グラフの目盛りを読む",
        "表やグラフから差や合計を求める"
      ],
      "typical_mistakes": [
        "1目盛りの大きさを1と決めつける"
      ],
      "sample_questions": [
        {
          "q": "1目盛りが5人の棒グラフで4目盛りなら何人？",
          "c": ["20人", "9人", "5人", "40人"],
          "a": 0,
          "e": "5×4=20人"
        }
      ]
    }
  ]
}
