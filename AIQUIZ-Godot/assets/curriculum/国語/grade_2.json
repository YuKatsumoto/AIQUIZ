{
  "grade": 2,
  "subject": "国語",
  "keywords": "1年漢字80字,物語文,主語と述語,日記,手紙",
  "bad_examples": [
    "敬語の使い分けは？（高学年）"
  ],
  "units": [
    {
      "name": "1年生の漢字(80字)",
      "key_concepts": [
        "画数",
        "書き順",
        "読み方(音読み・訓読み)"
      ],
      "typical_mistakes": [
        "「右」と「石」を混同",
        "書き順の間違い"
      ],
      "sample_questions": [
        {
          "q": "「山」の読み方は？",
          "c": [
            "やま・サン",
            "うみ・カイ",
            "かわ・セン",
            "もり・シン"
          ],
          "a": 0,
          "e": "山=やま(訓)・サン(音)"
        }
      ]
    },
    {
      "name": "主語と述語",
      "key_concepts": [
        "主語=だれが・なにが",
        "述語=どうする・どんなだ"
      ],
      "typical_mistakes": [
        "主語と述語を逆に答える"
      ],
      "sample_questions": [
        {
          "q": "「花が咲く」の主語は？",
          "c": [
            "花が",
            "咲く",
            "花",
            "が"
          ],
          "a": 0,
          "e": "「何が」=主語"
        }
      ]
    },
    {
      "name": "物語の読み取り",
      "key_concepts": [
        "場面の変化",
        "登場人物の気持ち"
      ],
      "typical_mistakes": [
        "自分の気持ちと登場人物の気持ちを混同"
      ],
      "sample_questions": [
        {
          "q": "物語で「いつ・どこで・だれが」を確認するのは？",
          "c": [
            "場面の設定",
            "あらすじ",
            "感想",
            "テーマ"
          ],
          "a": 0,
          "e": "5W1H=場面の設定"
        }
      ]
    },
    {
      "name": "なかまの言葉と漢字",
      "key_concepts": [
        "なかまの漢字(曜日・数・色)",
        "上位語と下位語"
      ],
      "typical_mistakes": [
        "「日」と「月」の曜日漢字を混同"
      ],
      "sample_questions": [
        {
          "q": "「赤・青・黄」をまとめると？",
          "c": [
            "色",
            "形",
            "数",
            "音"
          ],
          "a": 0,
          "e": "なかまの言葉=色"
        }
      ]
    },
    {
      "name": "様子をあらわす言葉",
      "key_concepts": [
        "様子の言葉(きれいだ・楽しい)",
        "動きの言葉(走る・食べる)"
      ],
      "typical_mistakes": [
        "様子の言葉と動きの言葉を混同"
      ],
      "sample_questions": [
        {
          "q": "「美しい花」の「美しい」は何を表す？",
          "c": [
            "様子",
            "動き",
            "名前",
            "数"
          ],
          "a": 0,
          "e": "どんなだ=様子の言葉"
        }
      ]
    },
    {
      "name": "かなづかいと長音・拗音",
      "key_concepts": [
        "「を・は・へ」の使い方",
        "のばす音の書き方"
      ],
      "typical_mistakes": [
        "「おうさま」を「おおさま」と書く"
      ],
      "sample_questions": [
        {
          "q": "正しい書き方はどれ？",
          "c": [
            "おねえさん",
            "おねいさん",
            "おねーさん",
            "おねへさん"
          ],
          "a": 0,
          "e": "え列の長音=え"
        }
      ]
    }
  ]
}