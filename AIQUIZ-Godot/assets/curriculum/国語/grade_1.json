{
  "grade": 1,
  "subject": "国語",
  "keywords": "ひらがな,カタカナ,小さい「っ」,のばす音,は・を・へ",
  "bad_examples": [
    "漢字の部首は？（高学年）"
  ],
  "units": [
    {
      "name": "ひらがなの読み書き",
      "key_concepts": [
        "46文字の読み書き",
        "濁音・半濁音"
      ],
      "typical_mistakes": [
        "「ぬ」と「め」を混同"
      ],
      "sample_questions": [
        {
          "q": "「きゅう」の小さい字はどれ？",
          "c": [
            "ゅ",
            "ゃ",
            "ょ",
            "っ"
          ],
          "a": 0,
          "e": "きゅう=き+ゅ+う"
        }
      ]
    },
    {
      "name": "カタカナの読み書き",
      "key_concepts": [
        "外来語をカタカナで書く"
      ],
      "typical_mistakes": [
        "「シ」と「ツ」を混同"
      ],
      "sample_questions": [
        {
          "q": "「りんご」を外国の言葉で書くと？",
          "c": [
            "りんご",
            "リンゴ",
            "アップル",
            "APPLE"
          ],
          "a": 2,
          "e": "外来語=カタカナ"
        }
      ]
    },
    {
      "name": "助詞「は・を・へ」",
      "key_concepts": [
        "「は」=わと読む場合",
        "「を」=おと読む",
        "「へ」=えと読む"
      ],
      "typical_mistakes": [
        "「は」と「わ」の使い分け"
      ],
      "sample_questions": [
        {
          "q": "「わたし＿学校へ行く」に入る文字は？",
          "c": [
            "わ",
            "は",
            "お",
            "を"
          ],
          "a": 1,
          "e": "主語の後は「は」"
        }
      ]
    },
    {
      "name": "小さい字とのばす音",
      "key_concepts": [
        "拗音「ゃゅょ」",
        "促音「っ」",
        "長音(のばす音)"
      ],
      "typical_mistakes": [
        "のばす音を「う」か「お」か迷う"
      ],
      "sample_questions": [
        {
          "q": "「がっこう」で小さく書く字は？",
          "c": [
            "が",
            "っ",
            "こ",
            "う"
          ],
          "a": 1,
          "e": "つまる音=小さい「っ」"
        }
      ]
    },
    {
      "name": "句読点とかぎかっこ",
      "key_concepts": [
        "「。」=文の終わり",
        "「、」=文の区切り",
        "「」=会話"
      ],
      "typical_mistakes": [
        "文の終わりに「、」を付ける"
      ],
      "sample_questions": [
        {
          "q": "話した言葉につける記号は？",
          "c": [
            "（　）",
            "「　」",
            "・",
            "～"
          ],
          "a": 1,
          "e": "会話=かぎかっこ「」"
        }
      ]
    },
    {
      "name": "反対の言葉・仲間の言葉",
      "key_concepts": [
        "反対の言葉(大きい⇔小さい)",
        "仲間の言葉(色・動物)"
      ],
      "typical_mistakes": [
        "反対の言葉を仲間の言葉と混同"
      ],
      "sample_questions": [
        {
          "q": "「たかい」の反対の言葉は？",
          "c": [
            "ひくい",
            "おおきい",
            "ながい",
            "はやい"
          ],
          "a": 0,
          "e": "たかい⇔ひくい"
        }
      ]
    }
  ]
}